# Copy to .env.cloudflare.local (ignored by Git). Never paste secrets into chat.
# Use a remote MongoDB Atlas connection with TLS, not localhost.
MONGODB_URI=
MONGODB_DB=money_manager
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public HTTPS URL returned by Cloudflare deployment.
AUTH_URL=
# Email(s) granted admin on their FIRST sign-in.
AUTH_ADMIN_EMAILS=
AUTH_TRUST_HOST=true
