# Copy to .env.local. docker compose up -d starts MongoDB on port 27019.
MONGODB_URI=mongodb://127.0.0.1:27019
MONGODB_DB=save_billion
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3100
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated verified Google emails. Grants admin ONLY at first registration.
AUTH_ADMIN_EMAILS=
