{
  "name": "money-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "webapp"
  ],
  "scripts": {
    "dev": "npm --prefix core run dev",
    "build": "npm --prefix webapp run build",
    "start": "npm --prefix core start",
    "lint": "eslint .",
    "typecheck": "npm --prefix webapp run typecheck",
    "test:integration": "node scripts/integration.mjs",
    "backend:build": "npm --prefix core run build",
    "backend:dev": "npm --prefix core run dev",
    "backend:start": "npm --prefix core start",
    "build:all": "npm run build && npm run backend:build",
    "dev:ui": "npm --prefix webapp run dev"
  },
  "devDependencies": {
    "@auth/core": "^0.41.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "mongodb": "^7.7.0",
    "typescript": "^6.0.3"
  }
}
