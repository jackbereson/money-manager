{
  "name": "money-manager",
  "main": "cloudflare/frontend.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/.env*",
      "/.git/*",
      "/key",
      "/backend/*",
      "/cloudflare/*",
      "/core/*",
      "/webapp/*"
    ]
  }
}
